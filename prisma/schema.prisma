generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DISPATCHER
  ADMIN
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

enum AmbulanceType {
  BASIC
  ICU
  CARDIAC
}

enum AmbulanceStatus {
  AVAILABLE
  ASSIGNED
  EN_ROUTE
  PICKING_UP
  TO_HOSPITAL
  MAINTENANCE
  OFFLINE
}

enum RequestPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RequestStatus {
  REQUESTED
  PRIORITY_ASSIGNED
  AMBULANCE_ASSIGNED
  DRIVER_ACCEPTED
  EN_ROUTE
  PATIENT_PICKED_UP
  TO_HOSPITAL
  ARRIVED
  COMPLETED
  CANCELLED
  FAILED
}

enum DispatchStatus {
  DISPATCHED
  ARRIVED_AT_SCENE
  EN_ROUTE_TO_HOSPITAL
  ARRIVED_AT_HOSPITAL
  COMPLETED
  CANCELLED
}

enum TripStatus {
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentProvider {
  BKASH
  STRIPE
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String
  role         Role      @default(PATIENT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  driver            Driver?
  emergencyRequests EmergencyRequest[] @relation("PatientRequests")
  dispatches        Dispatch[]         @relation("DispatcherDispatches")
  payments          Payment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  incidentHistories IncidentHistory[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Driver {
  id            String       @id @default(uuid())
  userId        String?      @unique
  name          String
  phone         String
  licenseNumber String       @unique
  isActive      Boolean      @default(true)
  ambulanceId   String?      @unique
  status        DriverStatus @default(OFF_DUTY)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  user       User?      @relation(fields: [userId], references: [id])
  ambulance  Ambulance? @relation
  dispatches Dispatch[]

  @@index([status])
}

model Ambulance {
  id                 String          @id @default(uuid())
  registrationNumber String          @unique
  type               AmbulanceType
  status             AmbulanceStatus @default(AVAILABLE)
  capacity           Int
  locationLat        Float
  locationLng        Float
  isActive           Boolean         @default(true)
  driverId           String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  driver     Driver?    @relation(fields: [driverId], references: [id])
  trips      Trip[]
  dispatches Dispatch[]

  @@index([status])
  @@index([deletedAt])
  @@index([status, deletedAt])
}

model Hospital {
  id                 String    @id @default(uuid())
  name               String
  address            String
  phone              String
  latitude           Float
  longitude          Float
  emergencyAvailable Boolean   @default(true)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  trips Trip[]

  @@index([deletedAt])
  @@index([emergencyAvailable, deletedAt])
}

model EmergencyRequest {
  id            String          @id @default(uuid())
  patientId     String
  description   String
  pickupAddress String
  pickupLat     Float
  pickupLng     Float
  priority      RequestPriority
  status        RequestStatus   @default(REQUESTED)
  requestedAt   DateTime        @default(now())
  completedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  patient           User              @relation("PatientRequests", fields: [patientId], references: [id])
  dispatches        Dispatch[]
  trips             Trip[]
  incidentHistories IncidentHistory[]

  @@index([status])
  @@index([priority])
  @@index([status, priority, createdAt])
}

model Dispatch {
  id                 String         @id @default(uuid())
  emergencyRequestId String
  ambulanceId        String
  driverId           String?
  dispatcherId       String
  assignedAt         DateTime       @default(now())
  acceptedAt         DateTime?
  completedAt        DateTime?
  status             DispatchStatus @default(DISPATCHED)

  emergencyRequest EmergencyRequest @relation(fields: [emergencyRequestId], references: [id])
  ambulance        Ambulance        @relation(fields: [ambulanceId], references: [id])
  driver           Driver?          @relation(fields: [driverId], references: [id])
  dispatcher       User             @relation("DispatcherDispatches", fields: [dispatcherId], references: [id])
  trips            Trip[]

  // Partial unique indexes (active dispatch only) are defined in SQL migration:
  // - one active dispatch per emergencyRequestId
  // - one active dispatch per ambulanceId
  @@index([emergencyRequestId])
  @@index([ambulanceId])
  @@index([status])
}

model Trip {
  id                 String     @id @default(uuid())
  emergencyRequestId String
  ambulanceId        String
  hospitalId         String?
  dispatchId         String?    @unique
  startedAt          DateTime?
  pickedUpAt         DateTime?
  arrivedAt          DateTime?
  completedAt        DateTime?
  status             TripStatus @default(ONGOING)
  distance           Float?
  fare               Float?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  emergencyRequest EmergencyRequest @relation(fields: [emergencyRequestId], references: [id])
  ambulance        Ambulance        @relation(fields: [ambulanceId], references: [id])
  hospital         Hospital?        @relation(fields: [hospitalId], references: [id])
  dispatch         Dispatch?        @relation(fields: [dispatchId], references: [id])
  payment          Payment?
}

model Payment {
  id            String          @id @default(uuid())
  tripId        String          @unique
  patientId     String
  amount        Float
  currency      String          @default("BDT")
  transactionId String?
  provider      PaymentProvider @default(BKASH)
  status        PaymentStatus   @default(PENDING)
  paymentUrl    String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  trip    Trip @relation(fields: [tripId], references: [id])
  patient User @relation(fields: [patientId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model IncidentHistory {
  id                 String   @id @default(uuid())
  emergencyRequestId String
  action             String
  details            String?
  actorId            String? // User ID who performed the action
  createdAt          DateTime @default(now())

  emergencyRequest EmergencyRequest @relation(fields: [emergencyRequestId], references: [id])
  actor            User?            @relation(fields: [actorId], references: [id])
}
